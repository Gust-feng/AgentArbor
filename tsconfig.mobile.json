{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/app/mobile-ui/src/**/*.ts",
    "src/app/mobile-ui/src/**/*.tsx",
    "src/app/remote-collaboration/protocol.ts",
    "src/app/content-vault/contracts.ts",
    "src/app/content-vault/client.ts",
    "vite.mobile.config.ts"
  ]
}
