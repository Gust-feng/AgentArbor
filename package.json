{
  "name": "agentarbor",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "AgentArbor desktop general-agent workbench.",
  "scripts": {
    "clean:dist": "node scripts/clean-dist.mjs",
    "clean:workspace": "node scripts/clean-workspace.mjs",
    "build": "pnpm clean:dist && pnpm build:node && pnpm copy:sub-agents && pnpm typecheck:panel && pnpm build:panel",
    "build:node": "pnpm generate:icons && tsc -p tsconfig.json && pnpm copy:initial-workbench-assets",
    "copy:initial-workbench-assets": "node scripts/copy-initial-workbench-assets.mjs",
    "copy:sub-agents": "node scripts/copy-sub-agent-assets.mjs",
    "typecheck:panel": "tsc -p tsconfig.panel.json --noEmit",
    "build:panel": "vite build --config vite.panel.config.ts",
    "test:panel": "vitest run --config vitest.panel.config.ts",
    "test:release-gate": "node --test scripts/windows-release-validation.test.mjs",
    "test:dev-scripts": "node --test scripts/panel-dev-process-tree.test.mjs",
    "build:deferred": "tsc -p tsconfig.deferred.json",
    "test:deferred": "pnpm build:deferred && node scripts/run-deferred-tests.mjs",
    "test": "pnpm build && node scripts/run-node-tests.mjs && pnpm test:panel && pnpm test:release-gate && pnpm test:dev-scripts",
    "smoke:real-ai": "pnpm build && node dist/app/real-ai-smoke.js",
    "panel": "pnpm build && node dist/app/panel.js",
    "typecheck:mobile": "tsc -p tsconfig.mobile.json --noEmit",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "mobile:sync": "pnpm build:mobile && capacitor sync android",
    "mobile:android:debug": "pnpm mobile:sync && cd android && gradlew.bat assembleDebug",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "test:mobile": "vitest run --config vitest.mobile.config.ts",
    "remote:service": "pnpm build:node && node dist/app/remote-service.js",
    "panel:dev": "node scripts/panel-dev.mjs",
    "panel:desktop:dev": "node scripts/panel-dev.mjs --desktop",
    "panel:desktop:dev:no-restart": "node scripts/panel-dev.mjs --desktop --no-restart",
    "panel:smoke": "pnpm build && node dist/app/panel.js --port 0 --smoke",
    "panel:desktop": "pnpm build && pnpm exec electron dist/app/panel-desktop.js",
    "panel:desktop:smoke": "pnpm build && pnpm exec electron dist/app/panel-desktop.js --port 0 --smoke",
    "panel:desktop:window-smoke": "pnpm build && pnpm exec electron dist/app/panel-desktop.js --port 0 --window-smoke",
    "generate:icons": "node scripts/generate-icon-assets.mjs",
    "dist:desktop:win": "pnpm build && pnpm exec electron-builder --win nsis --x64 --publish never",
    "publish:desktop:win": "pnpm dist:desktop:win && node scripts/publish-windows-release.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@electron/asar": "^4.2.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^36.9.5",
    "electron-builder": "^26.0.12",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.12",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/barcode-scanner": "3.1.0",
    "@capacitor/core": "8.5.0",
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "5.101.2",
    "@tiptap/extension-image": "^3.29.1",
    "@tiptap/extension-link": "^3.29.1",
    "@tiptap/extension-placeholder": "^3.29.1",
    "@tiptap/extension-table": "^3.29.1",
    "@tiptap/extension-task-item": "^3.29.1",
    "@tiptap/extension-task-list": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "chardet": "^2.2.0",
    "diff": "9.0.0",
    "docx-preview": "0.4.0",
    "electron-updater": "^6.6.2",
    "iconv-lite": "^0.7.3",
    "js-tiktoken": "^1.0.21",
    "lowlight": "^3.3.0",
    "lucide-react": "0.487.0",
    "motion": "^12.23.24",
    "openai": "^6.46.0",
    "qrcode.react": "4.2.0",
    "react": "^19.2.6",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.1",
    "remark-gfm": "^4.0.1",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "1.3.8",
    "unpdf": "1.6.2",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "main": "dist/app/panel-desktop.js",
  "productName": "AgentArbor"
}
